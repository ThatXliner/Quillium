// Zellij layout for collab development
// Usage: zellij --layout share-dev.kdl

layout {
    pane split_direction="horizontal" {
        pane {
            name "Quillium"
            command "bun"
            args "run" "tauri" "dev"
        }
        pane {
            name "Server"
            command "bash"
            args "-c" "cd ../quillium-landing && bun run dev"
        }
    }
}
