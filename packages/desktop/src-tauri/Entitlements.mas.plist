<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Mac App Store distribution -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- App and team identifiers (required by MAS) -->
    <key>com.apple.application-identifier</key>
    <string>QKY5V6T98V.com.bryanhu.quillium</string>
    <key>com.apple.developer.team-identifier</key>
    <string>QKY5V6T98V</string>

    <!-- Outbound network access (AI APIs, PostHog analytics) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Powerbox access for NSSavePanel/NSOpenPanel (document export).
         Without this, the sandboxed build crashes when the save dialog opens
         because the ViewBridge connection to the panel service is denied. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Keychain access for storing API keys -->
    <key>keychain-access-groups</key>
    <array>
        <string>QKY5V6T98V.com.bryanhu.quillium</string>
    </array>
</dict>
</plist>
