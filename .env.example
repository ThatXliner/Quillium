# Supabase configuration
# Get these values from your Supabase project's Connect dialog or Settings > API Keys.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Server-side only for relay/admin operations. Do not expose this in the desktop client.
SUPABASE_SECRET_KEY=your-secret-key-for-relay-only

# Collab relay server URL (optional, enables real-time collaboration)
# Use wss:// for production, ws:// for local development.
# Leave empty until the relay is deployed and DNS is live.
PUBLIC_RELAY_URL=
