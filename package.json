{
  "name": "quillium",
  "version": "0.20.1",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun run licenses && vite build",
    "licenses": "bun scripts/generate-licenses.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "dev:ios": "tauri ios dev",
    "tauri:dev2": "QUILLIUM_DEV_PORT=1422 tauri dev --config src-tauri/tauri.dev2.toml",
    "tauri:dev:mcp": "tauri dev -- --features mcp-bridge",
    "tauri:mas": "VITE_MAS=true tauri build --bundles app --target universal-apple-darwin -- --no-default-features --features mas",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "biome": "bun run format && bun run lint",
    "bump": "bash scripts/bump.sh",
    "bump:minor": "bash scripts/bump.sh minor",
    "bump:major": "bash scripts/bump.sh major",
    "screenshots": "bun scripts/screenshots.ts",
    "screenshots:no-server": "bun scripts/screenshots.ts --no-server",
    "changelog:shot": "bun scripts/changelog-shot.ts",
    "icons": "bun scripts/icons.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.72",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/google": "^3.0.65",
    "@ai-sdk/openai": "^2.0.105",
    "@ai-sdk/svelte": "^4.0.194",
    "@codemirror/collab": "^6.1.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/courier-prime": "^5.2.8",
    "@fontsource/eb-garamond": "^5.2.7",
    "@fontsource/ia-writer-quattro": "^5.2.5",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/opendyslexic": "^5.2.5",
    "@fontsource/raleway": "^5.2.8",
    "@supabase/auth-js": "2.105.1",
    "@supabase/supabase-js": "^2.105.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "ai": "^6.0.194",
    "bits-ui": "^1.8.0",
    "crelt": "^1.0.6",
    "dompurify": "^3.4.2",
    "harper.js": "^2.0.0",
    "lodash-es": "^4.18.1",
    "lucide-svelte": "^0.475.0",
    "paneforge": "^1.0.2",
    "posthog-js": "^1.372.5",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "socket.io-client": "^4.8.3",
    "svelte-sonner": "^1.1.1",
    "unified": "^11.0.5",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.58.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.11.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/lodash-es": "^4.17.12",
    "@vitest/coverage-v8": "^4.1.5",
    "fast-check": "^4.7.0",
    "jsdom": "^28.1.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "supabase": "^2.97.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.6.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.5"
  }
}
